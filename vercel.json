{
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": "https://smartsales-backend-783403173685.europe-west1.run.app/api/v1",
    "NEXT_PUBLIC_FRONTEND_URL": "https://smartsales-frontend.vercel.app"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "https://smartsales-backend-783403173685.europe-west1.run.app/api/v1",
      "NEXT_PUBLIC_FRONTEND_URL": "https://smartsales-frontend.vercel.app"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
