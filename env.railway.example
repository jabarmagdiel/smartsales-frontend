# Variables de entorno para Railway - Frontend SmartSales
# Configura estas variables en el panel de Railway

# URL del backend (Railway genera automáticamente estas URLs)
NEXT_PUBLIC_API_BASE_URL=https://tu-backend-railway.railway.app/api/v1

# URL del frontend (Railway genera automáticamente)
NEXT_PUBLIC_FRONTEND_URL=https://tu-frontend-railway.railway.app

# Entorno de producción
NODE_ENV=production

# Puerto (Railway lo maneja automáticamente)
PORT=3000

# Variables adicionales para Railway
RAILWAY_ENVIRONMENT=production
