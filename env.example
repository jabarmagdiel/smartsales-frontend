# Variables de entorno para el frontend de SmartSales
# Copia este archivo a .env.local para desarrollo

# URL del backend API
NEXT_PUBLIC_API_BASE_URL=https://tu-backend.railway.app/api/v1

# URL del frontend (para CORS)
NEXT_PUBLIC_FRONTEND_URL=https://tu-frontend.vercel.app

# Configuración de desarrollo
NODE_ENV=production
